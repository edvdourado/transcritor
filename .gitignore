# Configurações reais; preservar exemplos revisados.
.env
.env.*
!.env.example
!.env.*.example
*.env
.htpasswd*
credentials*.json
secrets.*

# Dependências, builds e caches.
.venv/
venv/
node_modules/
dist/
build/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vite/
coverage/
htmlcov/
.coverage*
*.tsbuildinfo

# Dados de execução, pacotes locais e modelos.
var/
cache/
tmp/
temp/
logs/
*.log
models/
ggml-*.bin
*.gguf
*.safetensors
*.pt
*.pth
*.onnx
*.tar
*.tar.gz
*.tgz
*.zip
*.whl

# Áudios/transcrições privados. Não ignorar todo *.txt ou *.json.
recordings/
uploads/
transcripts/
transcriptions/
private/
*.wav
*.mp3
*.m4a
*.ogg
*.opus
*.flac
*.aac
*.webm
*.mp4
*.srt
*.vtt

# Chaves e certificados privados.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*

# Artefatos do sistema/editor.
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Fixtures sintéticas/públicas intencionais; revisar antes de adicionar.
# Liberar apenas mídias de teste, sem liberar chaves ou ambientes.
!backend/tests/fixtures/**/*.wav
!backend/tests/fixtures/**/*.mp3
!backend/tests/fixtures/**/*.m4a
!backend/tests/fixtures/**/*.ogg
!backend/tests/fixtures/**/*.srt
!backend/tests/fixtures/**/*.vtt
!frontend/src/__fixtures__/**/*.wav
!frontend/src/__fixtures__/**/*.mp3
!frontend/src/__fixtures__/**/*.m4a
!frontend/src/__fixtures__/**/*.ogg
!frontend/src/__fixtures__/**/*.srt
!frontend/src/__fixtures__/**/*.vtt
