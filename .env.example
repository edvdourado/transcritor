# Listener do backend (mantenha loopback em produção).
TRANSCRITOR_HOST=127.0.0.1
TRANSCRITOR_PORT=8765

# Padrão de desenvolvimento: resultado fictício, sem modelos.
# Para transcrição real, use whisper e preencha os três caminhos abaixo.
TRANSCRITOR_ENGINE=mock
WHISPER_CLI_PATH=
WHISPER_MODEL_SMALL=
WHISPER_MODEL_MEDIUM=
WHISPER_THREADS=3
WHISPER_LANGUAGE=pt
WHISPER_TIMEOUT_SECONDS=7200
# Exemplos Linux: ver deploy/vps/.env.vps.example e docs/DEPLOY.md.

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Windows: C:/tools/ffmpeg/bin/ffmpeg.exe (e ffprobe.exe).
# Somente o caminho do executável; não acrescentar argumentos.
FFPROBE_TIMEOUT_SECONDS=15
FFMPEG_TIMEOUT_SECONDS=120
UPLOAD_TIMEOUT_SECONDS=120

# Diretório exclusivo, inclusive para spools multipart e WAVs.
TRANSCRITOR_TEMP_DIR=./tmp
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=1800
FILE_RETENTION_SECONDS=3600

# Espera artificial APÓS FFprobe/FFmpeg; somente engine=mock.
MOCK_PROCESSING_SECONDS=2
