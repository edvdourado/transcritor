# Instalar como /etc/transcritor.env, root:transcritor, modo 0640.
# Somente variáveis consumidas pelo backend; não contém credenciais.
TRANSCRITOR_ENGINE=whisper
TRANSCRITOR_HOST=127.0.0.1
TRANSCRITOR_PORT=8765
WHISPER_CLI_PATH=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_SMALL=/opt/whisper.cpp/models/ggml-small.bin
WHISPER_MODEL_MEDIUM=/opt/whisper.cpp/models/ggml-medium.bin
WHISPER_THREADS=3
WHISPER_LANGUAGE=pt
WHISPER_TIMEOUT_SECONDS=7200
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
TRANSCRITOR_TEMP_DIR=/var/lib/transcritor/jobs
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=1800
FFPROBE_TIMEOUT_SECONDS=15
FFMPEG_TIMEOUT_SECONDS=120
UPLOAD_TIMEOUT_SECONDS=120
FILE_RETENTION_SECONDS=3600
MOCK_PROCESSING_SECONDS=2
